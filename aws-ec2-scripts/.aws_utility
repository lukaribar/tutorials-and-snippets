# Simple EC2 utility.
# Defaults are intentionally fixed in-function to avoid shell-global config variables.

# Usage:
#   ec2_instance ip [instance_name]
#   ec2_instance start [instance_name] [host_name]
#   ec2_instance stop [instance_name]
#   ec2_instance help
ec2_instance() {
    local action="$1"
    local profile="default"
    local instance_name="${2:-your-default-instance-name}"
    local host_name="${3:-aws}"
    local config_path="$HOME/.ssh/config"
    local instance_id
    local ip
    local retries

    if ! command -v aws >/dev/null 2>&1; then
        echo "aws CLI is not installed or not on PATH"
        return 127
    fi

    case "$action" in
        ip|start|stop)
            ;;
        help|-h|--help|"")
            cat <<'USAGE'
Usage:
  ec2_instance ip [instance_name]
  ec2_instance start [instance_name] [host_name]
  ec2_instance stop [instance_name]
USAGE
            [ -n "$action" ] && return 0
            return 1
            ;;
        *)
            echo "Unknown action: $action"
            echo "Run: ec2_instance help"
            return 1
            ;;
    esac

    instance_id=$(command aws --profile "$profile" ec2 describe-instances \
        --filters "Name=tag:Name,Values=$instance_name" "Name=instance-state-name,Values=pending,running,stopping,stopped" \
        --query "Reservations[0].Instances[0].InstanceId" \
        --output text) || {
        echo "Failed to query instances named $instance_name"
        return 1
    }

    if [ -z "$instance_id" ] || [ "$instance_id" = "None" ]; then
        echo "No instance named $instance_name was found"
        return 1
    fi

    case "$action" in
        ip)
            ip=$(command aws --profile "$profile" ec2 describe-instances \
                --instance-ids "$instance_id" \
                --query "Reservations[0].Instances[0].PublicIpAddress" \
                --output text) || {
                echo "Failed to query public IP for instance $instance_name"
                return 1
            }

            if [ -z "$ip" ] || [ "$ip" = "None" ]; then
                echo "No IP address is set for instance $instance_name"
            else
                echo "IP address of instance $instance_name: $ip"
            fi
            ;;

        start)
            echo "Starting instance $instance_name (id: $instance_id)"
            command aws --profile "$profile" ec2 start-instances --instance-ids "$instance_id" >/dev/null || {
                echo "Failed to start instance $instance_name"
                return 1
            }

            command aws --profile "$profile" ec2 wait instance-running --instance-ids "$instance_id" || {
                echo "Instance did not reach running state"
                return 1
            }

            echo "Configuring new IP address in $config_path (may take a few seconds)"
            retries=120
            ip=""
            while [ "$retries" -gt 0 ]; do
                ip=$(command aws --profile "$profile" ec2 describe-instances \
                    --instance-ids "$instance_id" \
                    --query "Reservations[0].Instances[0].PublicIpAddress" \
                    --output text) || {
                    echo "Failed while polling public IP"
                    return 1
                }
                [ -n "$ip" ] && [ "$ip" != "None" ] && break
                retries=$((retries - 1))
                sleep 1
            done

            if [ -z "$ip" ] || [ "$ip" = "None" ]; then
                echo "Timed out waiting for public IP on instance $instance_name"
                return 1
            fi

            if [ ! -f "$config_path" ]; then
                echo "SSH config file not found: $config_path"
                return 1
            fi

            if ! grep -q "^Host $host_name$" "$config_path"; then
                echo "Host $host_name not found in $config_path"
                return 1
            fi

            sed -i.backup "/^Host $host_name$/{n;s/^[[:space:]]*HostName[[:space:]][[:space:]]*.*/  HostName $ip/;}" "$config_path" \
            && echo "Configured new IP address ($ip) in $config_path" \
            || {
                echo "Failed to update $config_path"
                return 1
            }
            ;;

        stop)
            echo "Stopping instance $instance_name (id: $instance_id)"
            command aws --profile "$profile" ec2 stop-instances --instance-ids "$instance_id" >/dev/null || {
                echo "Failed to stop instance $instance_name"
                return 1
            }
            ;;
    esac
}
